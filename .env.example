# Configure these values in Replit Secrets or your host's secret manager.
BOT_TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id

# Provider credentials.
WAIFU_IM_KEY=replace_with_waifu_im_api_key
NEKOBOT_AUTHORIZATION=replace_with_nekobot_authorization_value

# Optional behavior.
TESTING_GUILD_ID=
COMMAND_REGISTRATION_MODE=global
WAIFU_PICS=false
ALLOW_INSECURE_MEDIA_TLS=false
MEDIA_TIMEOUT_MS=15000
MAX_MEDIA_BYTES=10485760
LOG_LEVEL=info
LOG_COLORS=auto
LOG_FORMAT=pretty
